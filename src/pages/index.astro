---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="bg-black">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ytmusic-tui documentation</title>
</head>
<body class="bg-black/40 text-zinc-300 font-sans antialiased min-h-screen p-4 sm:p-8 md:p-12 selection:bg-sky-500/30 selection:text-sky-200">
  <div class="max-w-5xl mx-auto bg-zinc-950 rounded-2xl px-6 sm:p-1 md:p-0 shadow-2xl space-y-10">

    <header class="flex items-center justify-between pb-6">
      <div class="flex items-center gap-3">
        <span class="text-xl sm:text-2xl font-bold text-zinc-100 tracking-tight">ytmusic-tui</span>
      </div>
      <a href="https://github.com/Kumneger0/ytmusic-tui" target="_blank" rel="noopener noreferrer" class="text-sm sm:text-base font-medium text-sky-400 hover:text-sky-300 hover:underline transition-colors flex items-center gap-1">
        GitHub Repository &rarr;
      </a>
    </header>

    <!-- Main Section -->
    <section class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-bold text-zinc-100 tracking-tight">ytmusic-tui documentation</h1>
      <p class="text-lg sm:text-xl text-zinc-400 leading-relaxed">
        A fast, terminal user interface client for YouTube Music.
      </p>

      <!-- Demo Screenshot -->
      <div class="border border-zinc-800/90 rounded-xl overflow-hidden bg-black shadow-lg my-6">
        <img src="/ytmuic-tui.png" alt="ytmusic-tui demo screenshot" class="w-full h-auto block object-contain" />
      </div>
    </section>

    <!-- 1. Installation -->
    <section>
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80 pb-2 mb-4 pt-2">
        1. Installation
      </h2>
      <p class="text-base sm:text-lg text-zinc-300 mb-4">
        Download pre-built binaries from the <a href="https://github.com/Kumneger0/ytmusic-tui/releases" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline font-medium">GitHub Releases</a> page, or run an installer script:
      </p>

      <div class="space-y-4">
        <div>
          <span class="block text-sm font-semibold text-zinc-200 mb-2">Linux / macOS</span>
          <pre class="bg-black border border-zinc-800/90 rounded-xl p-4 sm:p-5 text-sm sm:text-base font-mono text-zinc-200 overflow-x-auto"><code>curl -fsSL https://raw.githubusercontent.com/Kumneger0/ytmusic-tui/main/install.sh | bash</code></pre>
        </div>

        <div>
          <span class="block text-sm font-semibold text-zinc-200 mb-2">Windows (PowerShell)</span>
          <pre class="bg-black border border-zinc-800/90 rounded-xl p-4 sm:p-5 text-sm sm:text-base font-mono text-zinc-200 overflow-x-auto"><code>iwr -useb https://raw.githubusercontent.com/Kumneger0/ytmusic-tui/main/install.ps1 | iex</code></pre>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-zinc-900">
        <p class="text-sm sm:text-base text-zinc-300 font-semibold mb-2">
          Required System Prerequisites:
        </p>
        <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-zinc-400 mb-4 ml-2">
          <li><code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">yt-dlp</code> — Extracting and fetching YouTube Music audio stream URLs.</li>
          <li><code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">ffmpeg</code> — Audio stream decoding and playback.</li>
        </ul>
        <p class="text-xs sm:text-sm text-zinc-400 mb-2">Install both using your system package manager:</p>
        <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-zinc-300 ml-2">
          <li><strong class="text-zinc-200">Ubuntu / Debian:</strong> <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">sudo apt install ffmpeg yt-dlp</code></li>
          <li><strong class="text-zinc-200">Arch Linux:</strong> <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">sudo pacman -S ffmpeg yt-dlp</code></li>
          <li><strong class="text-zinc-200">Fedora:</strong> <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">sudo dnf install ffmpeg yt-dlp</code></li>
          <li><strong class="text-zinc-200">macOS:</strong> <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">brew install ffmpeg yt-dlp</code></li>
          <li><strong class="text-zinc-200">Windows:</strong> <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">winget install ffmpeg yt-dlp</code> or <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">scoop install ffmpeg yt-dlp</code></li>
        </ul>
      </div>
    </section>

    <!-- 2. Quick Start -->
    <section>
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80 pb-2 mb-4 pt-2">
        2. Quick Start
      </h2>
      <p class="text-base sm:text-lg text-zinc-300 mb-4">
        Authenticate with your local browser session and launch the client:
      </p>
      <pre class="bg-black border border-zinc-800/90 rounded-xl p-4 sm:p-5 text-sm sm:text-base font-mono text-zinc-200 overflow-x-auto"><code># 1. Extract session cookies automatically from installed browser (chrome, firefox, safari)
ytmusic-tui extract-cookies

# 2. Launch the client
ytmusic-tui</code></pre>
    </section>

    <!-- 3. CLI Commands & Subcommands -->
    <section>
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80 pb-2 mb-4 pt-2">
        3. CLI Commands & Subcommands
      </h2>
      <div class="w-full overflow-x-auto border border-zinc-800/90 rounded-xl bg-black">
        <table class="w-full text-left text-sm sm:text-base border-collapse">
          <thead>
            <tr class="bg-zinc-900 text-zinc-100 uppercase text-xs tracking-wider border-b border-zinc-800/90">
              <th class="px-5 py-3.5 font-semibold">Command</th>
              <th class="px-5 py-3.5 font-semibold">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/90 text-zinc-300">
            <tr>
              <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap">ytmusic-tui</td>
              <td class="px-5 py-3.5">Launch the interactive terminal user interface.</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap">ytmusic-tui extract-cookies</td>
              <td class="px-5 py-3.5">Extract YouTube Music cookies from supported browsers (<code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs">chrome</code>, <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs">firefox</code>, <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs">safari</code>), verify via API, and store locally.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. Authentication Details -->
    <section class="space-y-4">
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80 pb-2 mb-4 pt-2">
        4. Authentication Details
      </h2>
      
      <div>
        <h3 class="text-base sm:text-lg font-semibold text-zinc-200 mb-2">Automatic Cookie Extraction</h3>
        <pre class="bg-black border border-zinc-800/90 rounded-xl p-4 sm:p-5 text-sm sm:text-base font-mono text-zinc-200 overflow-x-auto mb-3"><code>ytmusic-tui extract-cookies</code></pre>
        <p class="text-sm sm:text-base text-zinc-400">
          Supported browsers: <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">chrome</code>, <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">firefox</code>, <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">safari</code>.
        </p>
      </div>

      <div class="pt-4 border-t border-zinc-900">
        <p class="text-sm sm:text-base text-zinc-400 mb-2">
          Credentials are saved locally as <code class="bg-zinc-900 border border-zinc-800 text-zinc-200 px-1.5 py-0.5 rounded font-mono text-xs sm:text-sm">browser.json</code> in your config path:
        </p>
        <ul class="list-disc list-inside space-y-1 text-sm sm:text-base text-zinc-300 ml-2 font-mono">
          <li>Linux: ~/.config/ytmusic-tui/browser.json</li>
          <li>macOS: ~/Library/Application Support/ytmusic-tui/browser.json</li>
          <li>Windows: %APPDATA%\ytmusic-tui\browser.json</li>
        </ul>
      </div>
    </section>

    <!-- 5. TUI Keybindings -->
    <section class="space-y-6">
      <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-500 border-b border-zinc-800/80 pb-2 mb-4 pt-2">
        5. TUI Keybindings
      </h2>

      <div>
        <h3 class="text-base sm:text-lg font-semibold text-zinc-200 mb-3">Navigation & Focus</h3>
        <div class="w-full overflow-x-auto border border-zinc-800/90 rounded-xl bg-black">
          <table class="w-full text-left text-sm sm:text-base border-collapse">
            <thead>
              <tr class="bg-zinc-900 text-zinc-100 uppercase text-xs tracking-wider border-b border-zinc-800/90">
                <th class="px-5 py-3.5 font-semibold w-1/3">Key</th>
                <th class="px-5 py-3.5 font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/90 text-zinc-300">
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Tab</code> / <code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Shift + Tab</code></td>
                <td class="px-5 py-3.5">Cycle focus forward / backward (Sidebar &rarr; Main &rarr; Queue)</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Ctrl + k</code></td>
                <td class="px-5 py-3.5">Focus search bar input</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">j</code> / <code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Down</code></td>
                <td class="px-5 py-3.5">Navigate list item down / scroll lyrics down</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">k</code> / <code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Up</code></td>
                <td class="px-5 py-3.5">Navigate list item up / scroll lyrics up</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Enter</code></td>
                <td class="px-5 py-3.5">Play selected track / open playlist, album, or section</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Esc</code></td>
                <td class="px-5 py-3.5">Unfocus search bar or return to main Home sections</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="text-base sm:text-lg font-semibold text-zinc-200 mb-3">Playback & Queue Controls</h3>
        <div class="w-full overflow-x-auto border border-zinc-800/90 rounded-xl bg-black">
          <table class="w-full text-left text-sm sm:text-base border-collapse">
            <thead>
              <tr class="bg-zinc-900 text-zinc-100 uppercase text-xs tracking-wider border-b border-zinc-800/90">
                <th class="px-5 py-3.5 font-semibold w-1/3">Key</th>
                <th class="px-5 py-3.5 font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/90 text-zinc-300">
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Space</code></td>
                <td class="px-5 py-3.5">Play / Pause current track (when player focused)</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">n</code></td>
                <td class="px-5 py-3.5">Next track in queue or playback context</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">b</code></td>
                <td class="px-5 py-3.5">Previous track from history</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">a</code></td>
                <td class="px-5 py-3.5">Add selected track to queue (works in Playlists, Albums, Search, Home sections, and Related list)</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">r</code></td>
                <td class="px-5 py-3.5">Remove highlighted track from queue or related list</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">l</code></td>
                <td class="px-5 py-3.5">Toggle Like (♥) / Unlike (♡) for current track</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Ctrl + l</code></td>
                <td class="px-5 py-3.5">Open synced lyrics overlay</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Ctrl + q</code></td>
                <td class="px-5 py-3.5">Toggle Queue List vs Related Tracks view mode</td>
              </tr>
              <tr>
                <td class="px-5 py-3.5 font-mono text-zinc-200 whitespace-nowrap"><code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">q</code> / <code class="bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">Ctrl + c</code></td>
                <td class="px-5 py-3.5">Quit application</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </section>

    <!-- Footer -->
    <footer class="pt-8 border-t border-zinc-800/80 text-center text-sm text-zinc-500">
      ytmusic-tui &bull; <a href="https://github.com/Kumneger0/ytmusic-tui" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 transition-colors">GitHub Repository</a>
    </footer>

  </div>
</body>
</html>
